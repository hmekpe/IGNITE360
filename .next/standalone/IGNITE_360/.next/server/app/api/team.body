[{"id":"team-daniel","name":"Daniel Owusu","role":"Programmes Coordinator","shortBio":"Designs learning experiences that combine mentorship, action, and measurable growth.","bio":"Daniel oversees programme operations and supports delivery across leadership, digital, and employability tracks. He works closely with facilitators and mentors to keep every cohort practical and learner-centered.","image":"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=800&q=80","order":2,"socials":{"linkedin":"https://www.linkedin.com","x":"https://x.com/Ignite360_gh"}},{"id":"team-abena","name":"Abena Agyeman","role":"Mentorship Lead","shortBio":"Supports mentor networks and personal development journeys for young participants.","bio":"Abena leads mentorship design, helping learners connect with role models and build the confidence to pursue clear career and purpose goals.","image":"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=800&q=80","order":3,"socials":{"linkedin":"https://www.linkedin.com","facebook":"https://facebook.com/ignite360"}},{"id":"team-kwame","name":"Kwame Asare","role":"Partnerships and Community Engagement","shortBio":"Builds collaborations that expand access, visibility, and opportunity for young people.","bio":"Kwame works with schools, employers, community organisations, and supporters to strengthen Ignite360's reach and long-term impact.","image":"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=800&q=80","order":4,"socials":{"linkedin":"https://www.linkedin.com","tiktok":"https://www.tiktok.com/@ignite.360.0"}}]